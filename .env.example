FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database (MySQL or SQLite)
DATABASE_URL=mysql+pymysql://username:password@localhost/ai_edu
# For SQLite (simpler, for local dev):
# DATABASE_URL=sqlite:///ai_edu.db

# Google Gemini AI API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# YouTube Data API v3 Key
# Get yours at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your-youtube-api-key-here
